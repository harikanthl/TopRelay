// For local development and tests only. Real deployments are made by the toprelay agent over the Cloudflare API
// with the bindings in docs/protocol.md ("Worker configuration"). Secrets for `wrangler dev` go in .dev.vars.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toprelay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["global_fetch_strictly_public", "enable_request_signal"],
  "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "Relay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local-oauth-kv" }],
  "vars": {
    "PUBLIC_URL": "http://localhost:8787",
    "SERVICES": "[{\"name\":\"notes\",\"kind\":\"mcp\",\"gen\":1},{\"name\":\"files\",\"kind\":\"http\",\"gen\":1}]"
  }
}
